FROM ruby:3.4.12-bookworm

RUN apt-get update -qq \
    && apt-get install --no-install-recommends -y default-libmysqlclient-dev pkg-config \
    && rm -rf /var/lib/apt/lists/* \
    && gem install rails --version 8.1.4.1 --no-document

WORKDIR /app
EXPOSE 3000
CMD ["bin/rails", "server", "-b", "0.0.0.0"]
