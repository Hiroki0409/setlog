<% content_for :title, "トレーニング記録 | SetLog" %>

<div class="site-shell">
  <header class="site-header">
    <p class="site-name">SetLog</p>
  </header>

  <main class="home-content">
    <h1>トレーニング記録</h1>
    <p><strong>種目</strong> <%= @exercise.name %></p>
    <% if @input_date %>
      <p><strong>今回の実施日</strong> <time datetime="<%= @input_date.iso8601 %>"><%= @input_date.iso8601 %></time></p>
    <% end %>

    <% if flash[:notice].present? %>
      <p class="home-guide" role="status"><%= flash[:notice] %></p>
    <% end %>

    <% if @workout_record.errors.any? %>
      <div class="auth-errors" role="alert">
        <p>入力内容を確認してください。</p>
        <ul>
          <% @workout_record.errors.each do |error| %>
            <li><%= t("workout_records.errors.#{error.attribute}", locale: :ja, default: error.full_message) %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <section class="home-guide previous-workout" aria-labelledby="previous-workout-heading">
      <h2 id="previous-workout-heading">前回の記録</h2>
      <% if @input_date.nil? %>
        <p>実施日を選ぶと前回の記録が表示されます。</p>
      <% elsif @previous_workout_records.empty? %>
        <p>この実施日より前の記録はありません。</p>
      <% else %>
        <% previous_date = @previous_workout_records.first.performed_on.iso8601 %>
        <p>前回の実施日 <time datetime="<%= previous_date %>"><%= previous_date %></time></p>
        <table id="previous-workout-records">
          <thead>
            <tr>
              <th scope="col">重量（kg）</th>
              <th scope="col">回数</th>
              <th scope="col">セット数</th>
            </tr>
          </thead>
          <tbody>
            <% @previous_workout_records.each do |record| %>
              <tr>
                <td><%= number_with_precision(record.weight, precision: 2, strip_insignificant_zeros: true, delimiter: "") %></td>
                <td><%= record.reps %></td>
                <td><%= record.set_count %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
    </section>

    <%= form_with model: @workout_record, local: true, class: "auth-form" do |form| %>
      <%= form.hidden_field :exercise_id %>

      <% if @input_date %>
        <%= form.hidden_field :performed_on, value: @input_date.iso8601 %>
      <% else %>
        <div class="auth-field">
          <%= form.label :performed_on, "実施日" %>
          <%= form.date_field :performed_on, required: true %>
        </div>
      <% end %>

      <div class="auth-field">
        <%= form.label :weight, "重量（kg）" %>
        <%= form.text_field :weight, value: @workout_record.weight_before_type_cast, inputmode: "decimal", required: true %>
      </div>

      <div class="auth-field">
        <%= form.label :reps, "回数" %>
        <%= form.text_field :reps, value: @workout_record.reps_before_type_cast, inputmode: "numeric", required: true %>
      </div>

      <div class="auth-field">
        <%= form.label :set_count, "セット数" %>
        <%= form.text_field :set_count, value: @workout_record.set_count_before_type_cast,
                            inputmode: "numeric", required: true %>
      </div>

      <%= form.submit "記録を保存する", class: "button button-primary" %>
    <% end %>

    <%= link_to "記録一覧", workout_records_path(exercise_id: @exercise.id, performed_on: @input_date&.iso8601),
                class: "button button-secondary" %>
    <%= link_to "種目・実施日を選び直す", exercises_path, class: "button button-secondary" %>
  </main>
</div>
