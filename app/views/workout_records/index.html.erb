<% content_for :title, "記録一覧 | SetLog" %>

<div class="site-shell">
  <header class="site-header">
    <p class="site-name">SetLog</p>
  </header>

  <main class="home-content">
    <h1>記録一覧</h1>

    <% if @workout_records.empty? %>
      <p>まだ記録がありません。種目一覧から種目の登録や記録入力ができます。</p>
    <% else %>
      <ul class="workout-record-list">
        <% @workout_records.each do |record| %>
          <li class="home-guide">
            <p>
              <time datetime="<%= record.performed_on.iso8601 %>"><%= record.performed_on.iso8601 %></time>
              <strong><%= record.exercise.name %></strong>
            </p>
            <dl class="workout-record-values">
              <div>
                <dt>重量（kg）</dt>
                <dd><%= number_with_precision(record.weight, precision: 2, strip_insignificant_zeros: true, delimiter: "") %></dd>
              </div>
              <div>
                <dt>回数</dt>
                <dd><%= record.reps %></dd>
              </div>
              <div>
                <dt>セット数</dt>
                <dd><%= record.set_count %></dd>
              </div>
            </dl>
          </li>
        <% end %>
      </ul>
    <% end %>

    <% if @return_exercise %>
      <%= link_to "記録入力に戻る",
                  new_workout_record_path(exercise_id: @return_exercise.id, performed_on: @return_date),
                  class: "button button-primary" %>
    <% end %>
    <%= link_to "種目一覧へ", exercises_path, class: "button button-secondary" %>
  </main>
</div>
