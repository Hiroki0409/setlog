<% content_for :title, "記録一覧 | SetLog" %>

<div class="site-shell">
  <%= render "shared/site_header" %>

  <main class="home-content">
    <h1>記録一覧</h1>

    <% if flash[:notice].present? %>
      <p class="home-guide" role="status"><%= flash[:notice] %></p>
    <% end %>

    <% if @workout_records.empty? %>
      <p>まだ記録がありません。種目一覧から種目の登録や記録入力ができます。</p>
    <% else %>
      <ul class="workout-record-list">
        <% @workout_records.each do |record| %>
          <li class="home-guide">
            <%= render "summary", record: record %>
            <div class="workout-record-actions">
              <%= link_to "編集", edit_workout_record_path(record), class: "button button-secondary" %>
              <%= link_to "削除", confirm_delete_workout_record_path(record), class: "button button-secondary" %>
            </div>
          </li>
        <% end %>
      </ul>
    <% end %>

    <% if @return_exercise %>
      <%= link_to "記録入力に戻る",
                  new_workout_record_path(exercise_id: @return_exercise.id, performed_on: @return_date),
                  class: "button button-primary" %>
    <% end %>
    <%= link_to "種目一覧へ", exercises_path, class: "button button-secondary" %>
  </main>
</div>
